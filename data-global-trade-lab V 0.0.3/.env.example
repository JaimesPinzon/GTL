NEXT_PUBLIC_SUPABASE_URL=https://supabase.globaltradelab.site
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
TWELVEDATA_API_KEY=your-twelvedata-api-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
OPENAI_API_KEY=
OPENAI_NEWS_MODEL=gpt-5
AUTH_FRONTEND_ORIGINS=http://localhost:5173
AUTH_ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret-at-least-32-characters
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_CSRF_COOKIE_TTL_SECONDS=86400
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_SECURE=false
AUTH_USERS_STORE=supabase
AUTH_SESSION_STORE=supabase
AUTH_DATA_DIRECTORY=./data/auth
AUTH_DEBUG=false

